import Link from "next/link";
import { AuthPanel } from "@/components/cloud/auth-panel";
import { CloudShell,WorkspaceSetup } from "@/components/cloud/cloud-shell";
import { readSupabaseEnv } from "@/lib/supabase/env";
import { createServerSupabase } from "@/lib/supabase/server";
import { readCloudWorkspace } from "@/lib/server/queries";
export const dynamic="force-dynamic";
export default async function AppPage({searchParams}:{searchParams:Promise<Record<string,string|string[]|undefined>>}){const env=readSupabaseEnv();if(!env.configured)return <ConfigState missing={env.missing}/>;const params=await searchParams,supabase=await createServerSupabase(),{data,error}=await supabase.auth.getClaims(),claims=data?.claims;if(error||!claims?.sub)return <AuthPanel notice={typeof params.authError==="string"?params.authError:undefined}/>;const workspace=await readCloudWorkspace(claims.sub);if(!workspace)return <WorkspaceSetup email={typeof claims.email==="string"?claims.email:undefined} error={params.setup==="failed"?"failed":undefined}/>;return <CloudShell data={workspace} email={typeof claims.email==="string"?claims.email:undefined}/>}
function ConfigState({missing}:{missing:string[]}){return <main className="setup"><div className="logo-mark">R</div><p className="eyebrow">RELAY CRM · CLOUD MODE</p><h1>Требуется подключение Supabase</h1><p>Рабочий кабинет не переключается на локальное демо автоматически. Настройте Supabase и проверьте авторизацию, RLS и хранение данных перед использованием.</p><div className="config-list">{missing.map(name=><div className="config-item" key={name}><span>{name}</span><strong>не настроено</strong></div>)}</div><Link className="secondary" href="/demo">Перейти в локальное демо</Link><Link className="text-link" href="/">← На главную</Link></main>}
