# Browser-safe HTTPS URL from Supabase project settings. Required for /app.
NEXT_PUBLIC_SUPABASE_URL=
# Browser-safe publishable/anon key. Never use a service-role credential here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact canonical origin used for confirmation and password-recovery redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
