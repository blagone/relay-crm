# Public browser-safe Supabase URL. Required only for /app cloud mode.
NEXT_PUBLIC_SUPABASE_URL=
# Public publishable key. Never place service_role credentials here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Canonical deployed origin, for example https://relay.example.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
